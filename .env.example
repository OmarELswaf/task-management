# ============================================================
# Project-level environment for the Home Assignment stack.
#
# HOW THIS IS USED
#   This stack is a superset of the official Supabase self-hosted
#   Docker stack. The base services (kong, auth, db, storage, ...)
#   are defined in supabase/docker/docker-compose.yml and included
#   from the root docker-compose.yml.
#
#   - Vars consumed by the BASE compose file are read from
#     supabase/docker/.env (its sibling .env file). That file is
#     reconstructed on a fresh clone from its committed template:
#       cp supabase/docker/.env.example supabase/docker/.env
#   - Vars below (the project-level overlay) are consumed by the
#     ROOT docker-compose.yml (frontend build args, etc.):
#       cp .env.example .env
#
# SECURITY NOTE
#   These are LOCAL DEVELOPMENT credentials only (localhost, demo
#   HS256 JWTs, password "postgres"). Never use them in production.
# ============================================================


# ===============================
# PostgreSQL (Docker Supabase)
# ===============================

POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432


# ===============================
# JWT Configuration
# ===============================

JWT_SECRET=super-secret-jwt-token-for-home-assignment-2026-with-more-than-32-chars


# ===============================
# Supabase Keys
# ===============================

